{
  "name": "sandbox-sprinkles",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4176 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
