{
  "name": "sandbox-next",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter nudge-ui build -q && next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "playwright": "playwright test",
    "test:e2e": "NUDGE_UI_PLAYWRIGHT_SERVER=dev playwright test --project=dev && NUDGE_UI_PLAYWRIGHT_SERVER=prod playwright test --project=prod"
  },
  "dependencies": {
    "next": "~16.3.4",
    "nudge-ui": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "^5.9.3"
  }
}
