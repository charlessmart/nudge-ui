{
  "name": "nudge-ui",
  "version": "0.1.3",
  "description": "Development-only visual UI inspector. Primary distribution with per-host subpaths.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlessmart/nudge-ui.git",
    "directory": "packages/nudge-ui"
  },
  "bugs": {
    "url": "https://github.com/charlessmart/nudge-ui/issues"
  },
  "homepage": "https://github.com/charlessmart/nudge-ui#readme",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./project-files": {
      "types": "./dist/project/files.d.ts",
      "import": "./dist/project/files.js",
      "default": "./dist/project/files.js"
    },
    "./project-tokens": {
      "types": "./dist/project/tokens.d.ts",
      "import": "./dist/project/tokens.js",
      "default": "./dist/project/tokens.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport/index.js",
      "default": "./dist/transport/index.js"
    },
    "./project-identity": {
      "types": "./dist/project/identity.d.ts",
      "import": "./dist/project/identity.js",
      "default": "./dist/project/identity.js"
    },
    "./html-identity": {
      "types": "./dist/html/identity.d.ts",
      "import": "./dist/html/identity.js",
      "default": "./dist/html/identity.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@nudge-ui/css": "workspace:*",
    "parse5": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
