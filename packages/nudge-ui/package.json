{
  "name": "nudge-ui",
  "version": "0.1.3",
  "description": "Development-only visual UI inspector. One package, one subpath per host.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlessmart/nudge-ui.git",
    "directory": "packages/nudge-ui"
  },
  "bugs": {
    "url": "https://github.com/charlessmart/nudge-ui/issues"
  },
  "homepage": "https://github.com/charlessmart/nudge-ui#readme",
  "type": "module",
  "files": [
    "bin",
    "dist"
  ],
  "bin": {
    "nudge-ui": "./bin/nudge-ui.mjs"
  },
  "exports": {
    "./vite": {
      "types": "./dist/hosts/vite/index.d.ts",
      "import": "./dist/hosts/vite/index.js",
      "default": "./dist/hosts/vite/index.js"
    },
    "./vite/tokens": {
      "types": "./dist/hosts/vite/virtual/design-tokens.d.ts",
      "import": "./dist/hosts/vite/virtual/design-tokens.js",
      "default": "./dist/hosts/vite/virtual/design-tokens.js"
    },
    "./next": {
      "types": "./dist/hosts/next/index.d.ts",
      "import": "./dist/hosts/next/index.js",
      "default": "./dist/hosts/next/index.js"
    },
    "./next/loader": {
      "types": "./dist/hosts/next/loader.d.ts",
      "import": "./dist/hosts/next/loader.js",
      "default": "./dist/hosts/next/loader.js"
    },
    "./next/mount": {
      "types": "./dist/hosts/next/mount.d.ts",
      "import": "./dist/hosts/next/mount.js",
      "default": "./dist/hosts/next/mount.js"
    },
    "./next/component-runtime": {
      "types": "./dist/hosts/next/componentRuntime.d.ts",
      "import": "./dist/hosts/next/componentRuntime.js",
      "default": "./dist/hosts/next/componentRuntime.js"
    },
    "./astro": {
      "types": "./dist/hosts/astro/index.d.ts",
      "import": "./dist/hosts/astro/index.js",
      "default": "./dist/hosts/astro/index.js"
    },
    "./astro/bootstrap": {
      "types": "./dist/hosts/astro/bootstrap.d.ts",
      "import": "./dist/hosts/astro/bootstrap.js",
      "default": "./dist/hosts/astro/bootstrap.js"
    },
    "./static": {
      "types": "./dist/hosts/static/index.d.ts",
      "import": "./dist/hosts/static/index.js",
      "default": "./dist/hosts/static/index.js"
    },
    "./static/bootstrap": {
      "types": "./dist/hosts/static/html/bootstrap.d.ts",
      "import": "./dist/hosts/static/html/bootstrap.js",
      "default": "./dist/hosts/static/html/bootstrap.js"
    },
    "./static/manifest": {
      "types": "./dist/hosts/static/manifest.d.ts",
      "import": "./dist/hosts/static/manifest.js",
      "default": "./dist/hosts/static/manifest.js"
    },
    "./static/server": {
      "types": "./dist/hosts/static/server.d.ts",
      "import": "./dist/hosts/static/server.js",
      "default": "./dist/hosts/static/server.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs && node scripts/build-next-loaders.mjs && node scripts/build-static-cli.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@nudge-ui/compiler": "workspace:*",
    "@nudge-ui/css": "workspace:*",
    "@nudge-ui/inspector": "workspace:*",
    "magic-string": "^0.30.21",
    "parse5": "^7.3.0",
    "postcss": "^8.5.26",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "astro": ">=5.0.0",
    "next": ">=15.3 <17",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro": "^7.2.10",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
