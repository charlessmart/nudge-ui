{
  "name": "nudge-ui",
  "version": "0.2.0",
  "description": "Development-only visual UI inspector. One package, one subpath per host.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlessmart/nudge-ui.git",
    "directory": "packages/nudge-ui"
  },
  "bugs": {
    "url": "https://github.com/charlessmart/nudge-ui/issues"
  },
  "homepage": "https://github.com/charlessmart/nudge-ui#readme",
  "type": "module",
  "files": [
    "bin",
    "dist"
  ],
  "bin": {
    "nudge-ui": "./bin/nudge-ui.mjs"
  },
  "exports": {
    "./vite": {
      "types": "./dist/hosts/vite/index.d.ts",
      "import": "./dist/hosts/vite/index.js",
      "default": "./dist/hosts/vite/index.js"
    },
    "./next": {
      "types": "./dist/hosts/next/index.d.ts",
      "import": "./dist/hosts/next/index.js",
      "default": "./dist/hosts/next/index.js"
    },
    "./astro": {
      "types": "./dist/hosts/astro/index.d.ts",
      "import": "./dist/hosts/astro/index.js",
      "default": "./dist/hosts/astro/index.js"
    },
    "./static": {
      "types": "./dist/hosts/static/index.d.ts",
      "import": "./dist/hosts/static/index.js",
      "default": "./dist/hosts/static/index.js"
    },
    "./testing": {
      "types": "./dist/inspector/testing.d.ts",
      "import": "./dist/inspector/testing.js",
      "default": "./dist/inspector/testing.js"
    },
    "./virtual-design-tokens": {
      "types": "./dist/css/virtual-design-tokens.d.ts"
    },
    "./internal/client": {
      "import": "./dist/client.mjs",
      "default": "./dist/client.mjs"
    },
    "./internal/inspector": {
      "types": "./dist/inspector/index.d.ts",
      "import": "./dist/inspector/index.js",
      "default": "./dist/inspector/index.js"
    },
    "./internal/component-runtime": {
      "types": "./dist/inspector/componentSemantics/reactRuntime.d.ts",
      "import": "./dist/inspector/componentSemantics/reactRuntime.js",
      "default": "./dist/inspector/componentSemantics/reactRuntime.js"
    },
    "./internal/host-runtime": {
      "types": "./dist/inspector/componentSemantics/runtimeBridge.d.ts",
      "import": "./dist/inspector/componentSemantics/runtimeBridge.js",
      "default": "./dist/inspector/componentSemantics/runtimeBridge.js"
    },
    "./internal/next/mount": {
      "types": "./dist/hosts/next/mount.d.ts",
      "import": "./dist/hosts/next/mount.js",
      "default": "./dist/hosts/next/mount.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs && node ../../scripts/vendor-agent-protocol.mjs && node scripts/build-inspector-client.mjs && node scripts/build-next-loaders.mjs && node scripts/build-static-cli.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:watch": "vitest --config vitest.unit.config.ts",
    "test:ui-integration": "vitest run src/inspector/styleEditors/LayoutSection.test.tsx src/inspector/styleEditors/LayoutComboField.test.tsx src/inspector/tokens/TokenDropdown.test.tsx src/inspector/ui/ui.test.tsx src/inspector/styleEditors/LayoutDropdown.test.tsx src/inspector/tokens/TokenField.test.tsx src/inspector/styleEditors/Typography.test.tsx src/inspector/styleEditors/BorderEditor.test.tsx src/inspector/styleEditors/AspectRatioField.test.tsx",
    "test:unit:full": "vitest run"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@base-ui/react": "^1.7.0",
    "@tabler/icons-react": "^3.46.0",
    "magic-string": "^0.30.21",
    "modern-screenshot": "^4.7.0",
    "parse5": "^7.3.0",
    "perfect-freehand": "^1.2.3",
    "postcss": "^8.5.26",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "astro": ">=5.0.0",
    "next": ">=15.3 <17",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nudge-ui/agent-protocol": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "astro": "^7.2.10",
    "esbuild": "^0.28.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
