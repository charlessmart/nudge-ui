{
  "name": "@nudge-ui/astro",
  "version": "0.1.0",
  "description": "Astro integration for the Nudge UI development inspector.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlessmart/nudge-ui.git",
    "directory": "packages/astro"
  },
  "bugs": {
    "url": "https://github.com/charlessmart/nudge-ui/issues"
  },
  "homepage": "https://github.com/charlessmart/nudge-ui#readme",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "import": "./dist/bootstrap.js",
      "default": "./dist/bootstrap.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@nudge-ui/inspector": "workspace:*",
    "@nudge-ui/vite-react": "workspace:*",
    "parse5": "^7.3.0"
  },
  "peerDependencies": {
    "astro": ">=5.0.0",
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "astro": "^7.2.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
