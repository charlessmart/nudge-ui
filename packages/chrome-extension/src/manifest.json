{
  "manifest_version": 3,
  "name": "Nudge UI",
  "description": "A design panel for any web page. Click an element, adjust it live, and hand the result to your coding agent as a structured prompt.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Toggle Nudge UI",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Toggle Nudge UI on the current tab"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "fontSettings"],
  "web_accessible_resources": [
    { "resources": ["cursors/*.svg"], "matches": ["<all_urls>"], "use_dynamic_url": true }
  ],
  "minimum_chrome_version": "130"
}
