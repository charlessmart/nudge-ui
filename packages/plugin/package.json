{
  "name": "@nudge-ui/plugin",
  "version": "0.0.1",
  "description": "Vite development plugin for Nudge UI identity, tokens, and inspector bootstrap.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharlesSmartEnv/design-tool.git",
    "directory": "packages/plugin"
  },
  "bugs": {
    "url": "https://github.com/CharlesSmartEnv/design-tool/issues"
  },
  "homepage": "https://github.com/CharlesSmartEnv/design-tool#readme",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/virtual/design-tokens.d.ts",
      "import": "./dist/virtual/design-tokens.js",
      "default": "./dist/virtual/design-tokens.js"
    },
    "./vanilla-extract-runtime": {
      "types": "./dist/adapters/vanillaExtractRuntime.d.ts",
      "import": "./dist/adapters/vanillaExtractRuntime.js",
      "default": "./dist/adapters/vanillaExtractRuntime.js"
    },
    "./identity": {
      "types": "./dist/transform/injectDataCid.d.ts",
      "import": "./dist/transform/injectDataCid.js",
      "default": "./dist/transform/injectDataCid.js"
    },
    "./component-contracts": {
      "types": "./dist/components/extractContracts.d.ts",
      "import": "./dist/components/extractContracts.js",
      "default": "./dist/components/extractContracts.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@nudge-ui/css": "workspace:*",
    "@nudge-ui/inspector": "workspace:*",
    "magic-string": "^0.30.21",
    "postcss": "^8.5.26",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "vite": "^8.2.2",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
