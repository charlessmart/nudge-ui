{
  "name": "@nudge-ui/vite-react",
  "version": "0.1.3",
  "description": "Vite + React development integration for Nudge UI identity, tokens, and inspector bootstrap.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlessmart/nudge-ui.git",
    "directory": "packages/plugin"
  },
  "bugs": {
    "url": "https://github.com/charlessmart/nudge-ui/issues"
  },
  "homepage": "https://github.com/charlessmart/nudge-ui#readme",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/virtual/design-tokens.d.ts",
      "import": "./dist/virtual/design-tokens.js",
      "default": "./dist/virtual/design-tokens.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@nudge-ui/compiler": "workspace:*",
    "@nudge-ui/css": "workspace:*",
    "@nudge-ui/inspector": "workspace:*",
    "magic-string": "^0.30.21",
    "postcss": "^8.5.26",
    "nudge-ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "vite": "^8.2.2",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
