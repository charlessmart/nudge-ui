{
  "name": "@nudge-ui/mcp",
  "version": "0.2.1",
  "description": "Optional local MCP companion for pairing Nudge UI with coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlessmart/nudge-ui.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/charlessmart/nudge-ui/issues"
  },
  "homepage": "https://github.com/charlessmart/nudge-ui#readme",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nudge-mcp": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js",
      "default": "./dist/bridge.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js",
      "default": "./dist/project.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs && node ../../scripts/vendor-agent-protocol.mjs && node scripts/build.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nudge-ui/agent-protocol": "workspace:*",
    "@types/node": "^22.20.1",
    "esbuild": "^0.21.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
