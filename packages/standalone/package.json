{
  "name": "@nudge-ui/standalone",
  "version": "0.1.3",
  "description": "Standalone static HTML host and inspector client for Nudge UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlessmart/nudge-ui.git",
    "directory": "packages/standalone"
  },
  "bugs": {
    "url": "https://github.com/charlessmart/nudge-ui/issues"
  },
  "homepage": "https://github.com/charlessmart/nudge-ui#readme",
  "type": "module",
  "files": [
    "bin",
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nudge-ui": "./bin/nudge-ui.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./html/identity": {
      "types": "./dist/html/identity.d.ts",
      "import": "./dist/html/identity.js",
      "default": "./dist/html/identity.js"
    },
    "./html/bootstrap": {
      "types": "./dist/html/bootstrap.d.ts",
      "import": "./dist/html/bootstrap.js",
      "default": "./dist/html/bootstrap.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs && node scripts/build.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@nudge-ui/css": "workspace:*",
    "nudge-ui": "workspace:*",
    "@nudge-ui/inspector": "workspace:*",
    "parse5": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.21.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
