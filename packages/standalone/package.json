{
  "name": "@nudge-ui/standalone",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "main": "src/index.ts",
  "bin": {
    "nudge-ui": "./bin/nudge-ui.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./html/identity": "./src/html/identity.ts",
    "./html/bootstrap": "./src/html/bootstrap.ts",
    "./manifest": "./src/manifest.ts",
    "./token-manifest": "./src/tokenManifest.ts",
    "./watcher": "./src/watcher.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@nudge-ui/css": "workspace:*",
    "@nudge-ui/inspector": "workspace:*",
    "parse5": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.21.5",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
