{
  "name": "@nudge-ui/css",
  "version": "0.1.3",
  "description": "Browser-safe CSS models, value semantics, and token inventory contracts for Nudge UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlessmart/nudge-ui.git",
    "directory": "packages/css"
  },
  "bugs": {
    "url": "https://github.com/charlessmart/nudge-ui/issues"
  },
  "homepage": "https://github.com/charlessmart/nudge-ui#readme",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "import": "./dist/model/index.js",
      "default": "./dist/model/index.js"
    },
    "./value-semantics": {
      "types": "./dist/value-semantics/index.d.ts",
      "import": "./dist/value-semantics/index.js",
      "default": "./dist/value-semantics/index.js"
    },
    "./dialects": {
      "types": "./dist/dialects/index.d.ts",
      "import": "./dist/dialects/index.js",
      "default": "./dist/dialects/index.js"
    },
    "./token-inventory": {
      "types": "./dist/token-inventory/index.d.ts",
      "import": "./dist/token-inventory/index.js",
      "default": "./dist/token-inventory/index.js"
    },
    "./virtual-design-tokens": {
      "types": "./dist/virtual-design-tokens.d.ts",
      "default": "./dist/virtual-design-tokens.d.ts"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "postcss": "^8.5.26"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
