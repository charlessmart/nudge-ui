{
  "name": "@nudge-ui/compiler",
  "version": "0.1.3",
  "description": "Host-neutral development source compilers for Nudge UI adapters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlessmart/nudge-ui.git",
    "directory": "packages/compiler"
  },
  "bugs": {
    "url": "https://github.com/charlessmart/nudge-ui/issues"
  },
  "homepage": "https://github.com/charlessmart/nudge-ui#readme",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react-identity": {
      "types": "./dist/reactIdentity.d.ts",
      "import": "./dist/reactIdentity.js",
      "default": "./dist/reactIdentity.js"
    },
    "./component-policy": {
      "types": "./dist/componentPolicyResolution.d.ts",
      "import": "./dist/componentPolicyResolution.js",
      "default": "./dist/componentPolicyResolution.js"
    },
    "./react-component-protocols": {
      "types": "./dist/reactComponentProtocols.d.ts",
      "import": "./dist/reactComponentProtocols.js",
      "default": "./dist/reactComponentProtocols.js"
    },
    "./component-contracts": {
      "types": "./dist/componentContracts.d.ts",
      "import": "./dist/componentContracts.js",
      "default": "./dist/componentContracts.js"
    },
    "./package-component-contracts": {
      "types": "./dist/packageComponentContracts.d.ts",
      "import": "./dist/packageComponentContracts.js",
      "default": "./dist/packageComponentContracts.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "magic-string": "^0.30.21",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
