{
  "name": "@nudge-ui/inspector",
  "version": "0.1.3",
  "description": "Browser runtime inspector for live UI selection, CSS previews, and agent prompts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlessmart/nudge-ui.git",
    "directory": "packages/inspector"
  },
  "bugs": {
    "url": "https://github.com/charlessmart/nudge-ui/issues"
  },
  "homepage": "https://github.com/charlessmart/nudge-ui#readme",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./component-runtime": {
      "types": "./dist/componentSemantics/reactRuntime.d.ts",
      "import": "./dist/componentSemantics/reactRuntime.js",
      "default": "./dist/componentSemantics/reactRuntime.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:full": "vitest run",
    "test:unit:watch": "vitest --config vitest.unit.config.ts",
    "test:ui-integration": "vitest run src/styleEditors/LayoutSection.test.tsx src/styleEditors/LayoutComboField.test.tsx src/tokens/TokenDropdown.test.tsx src/ui/ui.test.tsx src/styleEditors/LayoutDropdown.test.tsx src/tokens/TokenField.test.tsx src/styleEditors/Typography.test.tsx src/styleEditors/BorderEditor.test.tsx src/styleEditors/AspectRatioField.test.tsx"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@nudge-ui/agent-protocol": "workspace:*",
    "@nudge-ui/css": "workspace:*",
    "@tabler/icons-react": "^3.46.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
